HOST=127.0.0.1
PORT=3000
# Zvol alespoň 16 znaků. Bez hesla server nenastartuje.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Volitelné: účet lze připojit přímo v panelu e-mailem/heslem nebo cookie.
AL_AUTH_COOKIE=
AL_COOKIE_NAME=auth
DATA_DIR=./data
# Volitelné: veřejná HTTPS adresa panelu pro kontrolu Origin, např. https://al.example.cz
PUBLIC_ORIGIN=
MAX_CHARACTERS=4
# Panel běží jen přes HTTPS. Bez TLS_CERT_FILE/TLS_KEY_FILE si vygeneruje self-signed
# certifikát do DATA_DIR/tls pro localhost, 127.0.0.1, ::1, hostitele z PUBLIC_ORIGIN
# a další názvy z TLS_HOSTNAMES (čárkami oddělené DNS jména nebo IP adresy).
TLS_HOSTNAMES=
# Volitelně vlastní certifikát PEM / fullchain a privátní klíč PEM.
TLS_CERT_FILE=
TLS_KEY_FILE=
# Pouze pro zašifrovaný privátní klíč; běžný Let's Encrypt klíč heslo nemá.
TLS_KEY_PASSPHRASE=
# Pro compose.https.yaml: adresář s fullchain.pem a privkey.pem, veřejný port.
TLS_CERTS_DIR=./certs
HTTPS_PORT=443
# Volitelná upozornění (smrt, nečinnost, opakovaný reconnect, lektvary, pozastavený CODE).
# Discord: Nastavení kanálu → Integrace → Webhooky → Kopírovat URL webhooku.
DISCORD_WEBHOOK_URL=
# Telegram: token od @BotFather a ID chatu (číslo, u skupin záporné, nebo @kanal).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
