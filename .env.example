HOST=127.0.0.1
PORT=3000
# Zvol alespoň 16 znaků. Bez hesla server nenastartuje.
ADMIN_PASSWORD=
# Hodnota cookie auth z přihlášeného https://adventure.land (není to MCP token).
AL_AUTH_COOKIE=
AL_COOKIE_NAME=auth
DATA_DIR=./data
# Zapni za HTTPS reverzní proxy; pro localhost přes HTTP ponech false.
COOKIE_SECURE=false
# Volitelné: veřejná adresa panelu pro kontrolu Origin, např. https://al.example.cz
PUBLIC_ORIGIN=
MAX_CHARACTERS=4
