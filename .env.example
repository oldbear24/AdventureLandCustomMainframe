HOST=127.0.0.1
PORT=3000
# Zvol alespoň 16 znaků. Bez hesla server nenastartuje.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Volitelné: účet lze připojit přímo v panelu e-mailem/heslem nebo cookie.
AL_AUTH_COOKIE=
AL_COOKIE_NAME=auth
DATA_DIR=./data
# Zapni za HTTPS reverzní proxy; pro localhost přes HTTP ponech false.
COOKIE_SECURE=false
# Volitelné: veřejná adresa panelu pro kontrolu Origin, např. https://al.example.cz
PUBLIC_ORIGIN=
MAX_CHARACTERS=4
# Přímé HTTPS v aplikaci (certifikát PEM / fullchain a privátní klíč PEM).
TLS_ENABLED=false
TLS_CERT_FILE=
TLS_KEY_FILE=
# Pouze pro zašifrovaný privátní klíč; běžný Let's Encrypt klíč heslo nemá.
TLS_KEY_PASSPHRASE=
# Pro compose.https.yaml: adresář s fullchain.pem a privkey.pem, veřejný port.
TLS_CERTS_DIR=./certs
HTTPS_PORT=443
